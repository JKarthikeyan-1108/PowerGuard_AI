# ============================================
# PowerGuard Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit real secrets to version control

# ── Database ──────────────────────────────────
DATABASE_URL="mysql://root:powerguard@localhost:3306/powerguard"
MYSQL_ROOT_PASSWORD=powerguard
MYSQL_DATABASE=powerguard

# ── Backend Server ────────────────────────────
NODE_ENV=development
SERVER_PORT=4000
SERVER_URL=http://localhost:4000

# ── JWT ───────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PowerGuard

# ── AI Service ────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# ── MQTT ──────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── CSRF ──────────────────────────────────────
# Generate with: openssl rand -hex 32
CSRF_SECRET=your-csrf-secret-change-in-production

# ── Cookies ───────────────────────────────────
# Set COOKIE_DOMAIN for production (e.g., .powerguard.io)
# Leave blank for localhost development
COOKIE_DOMAIN=

# ── Google OAuth ──────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create/select a project
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 4. Application type: Web application
# 5. Authorized JavaScript origins: http://localhost:3000
# 6. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# 7. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Exposed to browser (only the Client ID — NEVER expose Client Secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Twilio Verify (Phone OTP) ─────────────────
# 1. Sign up at https://www.twilio.com
# 2. Create a Verify Service at https://console.twilio.com/us1/verify/services
# 3. Copy Account SID, Auth Token, and Verify Service SID below
# Note: Twilio Verify handles OTP generation, rate limiting, and expiry
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs
