# ============================================
# PowerGuard AI — Master Environment Configuration
# ============================================
# Copy this file to .env or .env.local and fill in your values
# NEVER commit real credentials, service-account JSONs, or secret keys to Git!

# ── 1. Application Environment ────────────────
NODE_ENV=development
SERVER_PORT=4000
SERVER_URL=http://localhost:4000

# ── 2. Frontend & Vercel Settings ─────────────
NEXT_PUBLIC_APP_NAME=PowerGuard AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── 3. Firebase Client SDK (Exposed to Browser) ───────────
# Obtain from Firebase Console → Project Settings → General → Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyPlaceholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=powerguard-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=powerguard-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=powerguard-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ── 4. Firebase Admin SDK (SERVER-SIDE ONLY — NEVER EXPOSE!) ──
# Obtain from Firebase Console → Project Settings → Service accounts → Generate new private key
# Option A (Recommended for Vercel): Inline raw JSON string or environment variables
FIREBASE_PROJECT_ID=powerguard-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@powerguard-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Complete JSON string on a single line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"powerguard-ai",...}

# ── 5. IoT Smart Meter Authentication ─────────
# Shared secret / API Key for ESP32 PZEM-004T and Sensor Simulator ingestion (/api/ingest)
IOT_DEVICE_API_KEY=powerguard-iot-secret-2026

# ── 6. AI & Machine Learning Service ──────────
# Optional external Python FastAPI microservice URL (defaults to built-in serverless inference if unset)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# ── 7. Database (Optional MySQL Backend) ──────
DATABASE_URL="mysql://root:powerguard@localhost:3306/powerguard"
MYSQL_ROOT_PASSWORD=powerguard
MYSQL_DATABASE=powerguard

# ── 8. Authentication & Security (JWT & CSRF) ──
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CSRF_SECRET=your-csrf-secret-change-in-production-min-32-chars
COOKIE_DOMAIN=
CORS_ORIGIN=http://localhost:3000

# ── 9. Google OAuth ───────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── 10. IoT MQTT Broker (Optional) ────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── 11. Rate Limiting & Logs ──────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=debug
LOG_DIR=./logs
